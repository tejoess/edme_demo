+# Scope contract for EPT-13 - Policy Endorsement: Customer-Requested Vehicle Updates
+# Generated by the planner (Phase 3). Part of what the human approves at Gate 1.
+
+ticket: EPT-13
+risk: HIGH   # schema changes + authorization-sensitive approval workflow - see plan.md "Risk"
+branch: feature/EPT-13
+
+acceptance_criteria:
+  - id: AC-001
+    text: "A customer can submit a vehicle detail update for their own ACTIVE policy; a new endorsement is created."
+  - id: AC-002
+    text: "Invalid vehicle information is rejected with a clear validation error and NO endorsement is created."
+  - id: AC-003
+    text: "A customer cannot submit an endorsement against a policy they do not own - the attempt is blocked (403)."
+  - id: AC-004
+    text: "Submitting an update creates an endorsement with status=Pending, snapshots old_values, and does NOT change the live vehicle details."
+  - id: AC-005
+    text: "After an admin approves, the vehicle row reflects the new details and the endorsement status becomes Approved with a decision date."
+  - id: AC-006
+    text: "The customer can view endorsement history for a policy showing old values, new values, request date and status for each change."
+  - id: AC-007
+    text: "After an admin rejects, the vehicle details remain unchanged and the endorsement status becomes Rejected with a decision date."
+  - id: AC-008
+    text: "Endorsements can only be submitted against policies in 'active' status (expired/cancelled/pending are rejected)."
+  - id: AC-009
+    text: "Approving/rejecting an endorsement is admin-only; non-admin callers get 403. Only Pending endorsements are decidable."
+  - id: AC-010
+    text: "Multiple Pending endorsements for the same policy are allowed (no conflict error at submit time)."
+
